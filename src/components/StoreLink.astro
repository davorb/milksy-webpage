---
import { APP_STORE } from '../data/site';
import { badgePath, translations, type Locale } from '../data/localization';
interface Props { badge?: boolean; label?: string; locale?: Locale }
const { badge = false, label = 'Download Milksy', locale = 'en' } = Astro.props;
const copy = translations[locale];
---
<a href={APP_STORE} class:list={['store-link', { badge, 'text-cta': !badge }]} data-cta="app-store" aria-label={badge ? `Milksy — ${copy.download}` : undefined}>
 {badge ? <img src={badgePath(locale)} width="180" height="60" alt={copy.download}/> : <>{label}<span aria-hidden="true">↗</span></>}
</a>
