---
import Layout from '../layouts/Layout.astro';
import AppScreenshot from '../components/AppScreenshot.astro';
import Icon from '../components/Icon.astro';
import StoreLink from '../components/StoreLink.astro';
import FAQ from '../components/FAQ.astro';
import { features, homeFAQ } from '../data/site';
---
<Layout home title="Baby Tracker for iPhone: Feeding & Diapers – Milksy" description="Track your baby’s feeds, diapers and daily activity with Milksy for iPhone and iPad. Keep a clear timeline, review trends and share the log with your partner." faqs={homeFAQ}>
 <section class="hero wrap">
  <div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> A calmer baby tracker</p><h1>Baby feeding &amp; diaper tracker<br/><span>for iPhone.</span></h1><p class="lead">Without the fuss. Milksy keeps feeds, diapers, and the little things in between in one simple baby log.</p><p class="hero-fact">See your baby’s day in a clear timeline, look back at everyday patterns, and share the log with your partner. Also available on iPad.</p><div class="hero-actions"><StoreLink badge/><a class="quiet-link" href="#features">Take a look <span aria-hidden="true">↓</span></a></div><p class="compatibility">For iPhone & iPad · iOS 26.5 or later</p></div>
  <figure class="hero-visual"><div class="screen-pair"><AppScreenshot screen="timeline" alt="Milksy Today timeline showing bottle and breastfeeding entries in chronological order" class="secondary-screen"/><AppScreenshot screen="today" alt="Milksy Today screen with the last feed, familiar feeding intervals, and a daily calendar" eager class="primary-screen"/></div><figcaption>Actual Milksy screens. A little more clarity.</figcaption></figure>
 </section>
 <div class="promise-strip wrap"><span><Icon name="clock"/> Log in seconds</span><span><Icon name="people"/> Share with your partner</span><span><Icon name="chart"/> See the everyday pattern</span></div>
 <section class="section wrap" id="features"><div class="section-heading"><p class="eyebrow">Less remembering. More being there.</p><h2>The essentials.<br/>All in one place.</h2><p>Open Milksy, log what happened, and carry on. Even when it’s 3 AM.</p></div><div class="feature-grid">{features.map(feature => <a class:list={['feature-card', feature.icon]} href={`/${feature.slug}/`}><span class="icon-tile"><Icon name={feature.icon}/></span><h3>{feature.title}</h3><p>{feature.text}</p><span class="card-link">Explore <Icon name="arrow"/></span></a>)}</div></section>
 <section class="timeline-section section"><div class="wrap split"><div class="screenshot-stage"><AppScreenshot screen="trends" alt="Milksy Trends with feeding totals, bottle volume, breastfeeding duration and a daily chart"/></div><div class="section-heading"><p class="eyebrow">One less thing to remember</p><h2>A busy day.<br/>A clear picture.</h2><p>When was the last bottle? Which side did you nurse on? Your Today feed keeps the day in order. Trends help you look back at feeds, amounts, and diapers over time.</p><ul class="check-list"><li>One chronological timeline</li><li>Feeding totals and daily patterns</li><li>A look back at familiar feeding intervals</li></ul><p class="small-note">Patterns come from your logs. They aren’t predictions.</p><a class="text-link" href="/baby-feeding-tracker/">See how the feeding log works <span aria-hidden="true">→</span></a></div></div></section>
 <section class="section wrap sharing"><div class="section-heading"><p class="eyebrow">A small app. A shared day.</p><h2>Both parents.<br/><span>One baby log.</span></h2><p>No more “Did you log that?” Invite your partner through iCloud and keep your baby’s activity in one shared timeline.</p><a class="text-link" href="/baby-tracker-for-couples/">See shared baby tracking for parents <span aria-hidden="true">→</span></a></div><div class="sharing-note glass"><span class="icon-tile"><Icon name="people"/></span><h3>Pick up where they left off.</h3><p>Check the latest feed before you take over. Add your own entry when you’re done. Both of you can follow the same day.</p><div class="note-divider"></div><p class="small-note">Sharing uses Apple CloudKit. Both parents need iCloud, and the family owner sends a private invitation.</p></div></section>
 <section class="values wrap"><div><p class="eyebrow">Deliberately simple</p><h2>Made for the moment.<br/>Not another to-do.</h2><p>Quick logging, calm screens, and useful history. Milksy also has sleep, pumping, and medication or vitamin logs when you need them.</p></div><div><p class="eyebrow">Your family’s information</p><h2>A clear word<br/>about privacy.</h2><p>Records are saved on your device. Family sharing uses iCloud and Apple CloudKit. Read how it works and find the app’s published privacy policy.</p><a class="text-link" href="/privacy/">Privacy details <span aria-hidden="true">→</span></a></div></section>
 <section class="section wrap faq-section"><div class="section-heading"><p class="eyebrow">The useful details</p><h2>A few things<br/>you might wonder.</h2></div><FAQ items={homeFAQ}/></section>
 <section class="wrap home-compare"><h2>Still choosing a baby tracker?</h2><p>Compare Milksy with Nara Baby, Huckleberry and Baby Tracker. See the features, sharing options and trade-offs.</p><a class="text-link" href="/compare/">Compare baby tracking apps <span aria-hidden="true">→</span></a></section>
 <section class="closing wrap glass"><img src="/app-icon.webp" width="76" height="76" alt="Milksy app icon" loading="lazy"/><h2>A little less<br/>to keep in your head.</h2><p>Your next feed, diaper, and handover.<br/>All a little easier to remember.</p><StoreLink label="Download on the App Store"/></section>
</Layout>
