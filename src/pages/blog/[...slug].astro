---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { publishedArticles } from '../../data/articles';
export async function getStaticPaths() { return (await publishedArticles()).map(post => ({ params: { slug: post.id }, props: { post } })); }
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={`${post.data.title} – Milksy`} description={post.data.description} article={{ title: post.data.title, date: post.data.publishedAt }}><article class="article-body"><p class="breadcrumb"><a href="/blog/">Milksy articles</a></p><h1>{post.data.title}</h1><p class="article-date"><time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('en', { timeZone: 'UTC', year:'numeric', month:'long', day:'numeric' })}</time></p><Content/></article></Layout>
