---
import '../styles/global.css';
import StoreLink from '../components/StoreLink.astro';
import { APP_STORE, type FAQ } from '../data/site';
interface Props { title: string; description: string; faqs?: FAQ[]; home?: boolean; noindex?: boolean; article?: { title: string; date: Date } }
const { title, description, faqs = [], home = false, noindex = false, article } = Astro.props;
const origin = Astro.site!;
const canonical = new URL(noindex ? "/404.html" : Astro.url.pathname, origin).href;
const schema = [
 { '@context': 'https://schema.org', '@type': 'WebSite', '@id': new URL('/#website', origin).href, name: 'Milksy', url: origin.href, description: 'Milksy is an iPhone baby tracker for breastfeeding, bottle feeds and diaper changes.', inLanguage: 'en' },
 ...(home ? [{ '@context': 'https://schema.org', '@type': ['MobileApplication', 'SoftwareApplication'], '@id': new URL('/#app', origin).href, name: 'Milksy', description, operatingSystem: 'iOS 26.5 or later; iPadOS 26.5 or later', applicationCategory: 'LifestyleApplication', url: origin.href, installUrl: APP_STORE, downloadUrl: APP_STORE, image: new URL('/app-icon.png', origin).href, sameAs: [APP_STORE] }] : []),
 ...(faqs.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) }] : []),
 ...(article ? [{ '@context': 'https://schema.org', '@type': 'BlogPosting', headline: article.title, description, datePublished: article.date.toISOString(), mainEntityOfPage: canonical, image: new URL('/social-card.jpg', origin).href, publisher: { '@type': 'Organization', name: 'Milksy', url: origin.href } }] : []),
];
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
 <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'}/>
 <meta property="og:type" content={article ? 'article' : 'website'}/><meta property="og:site_name" content="Milksy"/>
 <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
 <meta property="og:image" content={new URL('/social-card.jpg', origin).href}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Milksy — baby tracking without the fuss"/>
 <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL('/social-card.jpg', origin).href}/><meta name="twitter:image:alt" content="Milksy — baby tracking without the fuss"/>
 <meta name="apple-itunes-app" content="app-id=6810681675"/><meta name="theme-color" content="#f2f7ff"/>
 <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png"/><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
 <link rel="alternate" type="application/rss+xml" title="Milksy articles" href="/rss.xml"/>
 <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
</head>
<body>
 <a class="skip-link" href="#main">Skip to content</a>
 <header class="site-header wrap">
  <a class="brand" href="/" aria-label="Milksy home"><img src="/app-icon-small.webp" width="38" height="38" alt=""/>Milksy</a>
  <nav aria-label="Main navigation"><a href="/#features">Features</a><a href="/baby-tracker-for-couples/">For two</a><a href="/about/">About</a></nav>
  <StoreLink label="Get Milksy"/>
 </header>
 <main id="main"><slot/></main>
 <footer class="site-footer wrap"><div><a class="brand" href="/"><img src="/app-icon-small.webp" width="30" height="30" alt=""/>Milksy</a><p>A little less to remember.</p></div><nav aria-label="Footer navigation"><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/blog/">Articles</a><a href="mailto:davor@davor.se">Contact</a></nav><p class="legal">© {new Date().getFullYear()} Milksy. Apple and the Apple logo are trademarks of Apple Inc. App Store is a service mark of Apple Inc.</p></footer>
</body>
</html>
